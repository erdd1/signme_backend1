          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ancien_id\": 5,\n  \"mois\": 6,\n  \"annee\": 2026,\n  \"jours_travail\": [1, 2, 3, 4, 5],\n  \"horaire_debut\": \"08:00\",\n  \"horaire_fin\": \"18:00\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/anciens-designations",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "anciens-designations"
          ]
