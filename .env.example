APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Origines autorisées en CORS (séparées par des virgules).
# Production: remplacer par le(s) domaine(s) réel(s) du frontend.
CORS_ALLOWED_ORIGINS=http://192.168.1.112:8000,http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" tourne le fichier chaque jour et purge automatiquement les
# fichiers plus vieux que LOG_DAILY_DAYS — préférer à "single", qui écrit
# indéfiniment dans un seul fichier jamais purgé.
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

PAYMENT_QUEUE=payments
PAYMENT_QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=SignMe

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== SAUVEGARDES BASE DE DONNÉES (hors-site, tout fournisseur S3-compatible) =====
# Ex: Contabo Object Storage, Backblaze B2, AWS S3... Laisser vide en local :
# les sauvegardes restent alors uniquement sur le disque "backups-local"
# (storage/app/backups) et une alerte est journalisée à chaque exécution
# planifiée tant que ces identifiants ne sont pas renseignés.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_DEFAULT_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_URL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_USE_PATH_STYLE_ENDPOINT=true
# Nombre de jours de rétention avant suppression automatique des anciennes
# sauvegardes (local ET hors-site).
BACKUP_RETENTION_DAYS=30

# ===== GOOGLE SIGN-IN (OAuth) =====
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# ===== NOTCHPAY (Paiement Mobile Money Cameroun) =====
NOTCHPAY_PUBLIC_KEY=your_notchpay_public_key
NOTCHPAY_PRIVATE_KEY=your_notchpay_private_key
NOTCHPAY_WEBHOOK_HASH=your_notchpay_webhook_hash_key
NOTCHPAY_WEBHOOK_VERIFY_SIGNATURE=true
PAYMENT_DEFAULT_FEES=0
PAYMENT_GATEWAY=notchpay

# Retraits (payout NotchPay vers Orange Money/MTN) — taux réel non exposé par
# l'API NotchPay, à renseigner avec la valeur du contrat marchand.
NOTCHPAY_TRANSFER_FEE_PERCENT=0
RETRAIT_MONTANT_MIN=1000

# ===== SUPPORT CLIENT (WhatsApp) =====
WHATSAPP_SUPPORT_NUMBER=237699803165

# ===== FIREBASE (Notifications push FCM) =====
FIREBASE_CREDENTIALS=storage/app/private/firebase/firebase-service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ===== SANCTUM =====
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

VITE_APP_NAME="${APP_NAME}"

SIGNME_PASSWORD_RESET_DEEP_LINK=signme://reset-password
SIGNME_PASSWORD_RESET_WEB_URL="${APP_URL}/reset-password"

# ===== PARTAGE D'ÉVÉNEMENT (Android App Links / iOS Universal Links) =====
# APP_URL doit être le vrai domaine public en HTTPS (ex: https://signmecy.org)
# pour que /.well-known/assetlinks.json et /apple-app-site-association soient
# joignables par Google/Apple et que les liens ouvrent l'app directement.
ANDROID_PACKAGE_NAME=com.signmecy.mobile
# Empreintes SHA-256 séparées par une virgule (une par certificat de
# signature — debug ET release peuvent coexister ici pendant la transition).
ANDROID_SHA256_FINGERPRINTS=0C:51:12:1F:3B:F7:DB:5A:5A:77:A7:A8:69:37:81:34:1C:B7:18:5C:83:2A:E8:51:1D:03:D8:F6:2E:78:2C:61
# Team ID Apple Developer (ex: A1B2C3D4E5) — à renseigner dès la création du
# compte développeur, sinon les Universal Links iOS ne fonctionneront pas.
APPLE_TEAM_ID=TEAMID_A_REMPLACER
# Renseigner une fois l'app publiée (utilisés sur la page de partage web).
PLAY_STORE_URL=
APP_STORE_URL=

# ===== ASSISTANT RELIGIEUX (chatbot — aucune conversation stockée) =====
# Interrupteur : false = module désactivé (503).
ASSISTANT_ENABLED=true
# Moteur au format « chat/completions » : Groq par défaut (clé gratuite sur console.groq.com).
# Autre moteur = changer ces 3 lignes (Gemini, Mistral, OpenAI…), sans toucher au code.
ASSISTANT_API_URL=https://api.groq.com/openai/v1
ASSISTANT_API_KEY=
# Les modèles gratuits changent : lister ceux de la clé avec GET {ASSISTANT_API_URL}/models.
ASSISTANT_MODEL=openai/gpt-oss-120b
# Quota gratuit partagé : garder le plafond global sous la limite du moteur.
ASSISTANT_DAILY_LIMIT_USER=30
ASSISTANT_DAILY_LIMIT_GLOBAL=800

# ===== CHANTS (répertoire de chants — aucune parole stockée en base) =====
# Interrupteur : false = module désactivé (503), ex. en cas de réclamation d'un ayant droit.
CHANTS_ENABLED=true
# Jeton gratuit https://genius.com/api-clients — optionnel : permet de retrouver un chant
# à partir d'un extrait de paroles. Sans jeton, seule la recherche par titre/artiste marche.
CHANTS_GENIUS_TOKEN=
