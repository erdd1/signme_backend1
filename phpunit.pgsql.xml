<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration PHPUnit DÉDIÉE à la vérification PostgreSQL — jamais
    utilisée par défaut (phpunit.xml reste la config standard, SQLite en
    mémoire, rapide, inchangée). Cible explicitement `signme_bd_test`, une
    base PostgreSQL séparée créée uniquement pour les tests — RefreshDatabase
    exécute migrate:fresh entre les tests, JAMAIS pointer ceci sur
    `signme_bd` (les données réelles migrées).

    Usage : php artisan test -c phpunit.pgsql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_PGSQL_HOST" value="127.0.0.1"/>
        <env name="DB_PGSQL_PORT" value="5432"/>
        <env name="DB_PGSQL_DATABASE" value="signme_bd_test" force="true"/>
        <env name="DB_PGSQL_USERNAME" value="signme"/>
        <env name="DB_PGSQL_PASSWORD" value="SignMe2026App"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
